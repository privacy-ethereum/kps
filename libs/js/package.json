{
  "name": "kpstreams-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build -w @kpstreams/core && npm run build -w @kpstreams/webrtc-client && npm run build -w @kpstreams/quic-client && npm run build -w @kpstreams/server",
    "test": "npm run build -w @kpstreams/core && node --test packages/core/test/*.test.mjs",
    "test:integration": "npm run build && node --test --test-force-exit --test-concurrency=1 --test-timeout=90000 test/integration/*.test.mjs",
    "clean": "rm -rf packages/*/dist"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
