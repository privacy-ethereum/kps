{
  "name": "@kpstreams/webrtc-client",
  "version": "0.2.1",
  "description": "Browser WebRTC client for KPS: dial a server pinned by its certificate hash and open/accept unnamed byte streams. Zero native deps.",
  "keywords": ["kps", "webrtc", "webrtc-direct", "certhash", "key-pinning", "browser", "secure-transport", "p2p", "no-ca"],
  "type": "module",
  "license": "MIT",
  "author": "Andrew Morris",
  "repository": { "type": "git", "url": "git+https://github.com/ethereum/kps.git", "directory": "libs/js/packages/webrtc-client" },
  "homepage": "https://github.com/ethereum/kps/tree/main/libs/js/packages/webrtc-client#readme",
  "bugs": "https://github.com/ethereum/kps/issues",
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "src"],
  "dependencies": { "@kpstreams/core": "^0.2.1" },
  "scripts": { "build": "rm -rf dist && tsc", "prepack": "npm run build" },
  "devDependencies": { "typescript": "^5.6.0" }
}
