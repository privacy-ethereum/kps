  "type": "module",
  "license": "MIT",
  "author": "Andrew Morris",
  "repository": { "type": "git", "url": "git+https://github.com/privacy-ethereum/kps.git", "directory": "libs/js/packages/server" },
  "homepage": "https://github.com/privacy-ethereum/kps/tree/main/libs/js/packages/server#readme",
  "bugs": "https://github.com/privacy-ethereum/kps/issues",
