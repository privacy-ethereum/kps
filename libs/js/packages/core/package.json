{
  "name": "@kpstreams/core",
  "version": "0.2.1",
  "description": "Transport-neutral core for KPS: addresses, certhash, error model, and the Connection/Stream contract (plus the WebRTC wire protocol under ./webrtc). Zero runtime deps.",
  "keywords": ["kps", "certhash", "key-pinning", "secure-transport", "webrtc", "quic", "p2p", "no-ca"],
  "type": "module",
  "license": "MIT",
  "author": "Andrew Morris",
  "repository": { "type": "git", "url": "git+https://github.com/ethereum/kps.git", "directory": "libs/js/packages/core" },
  "homepage": "https://github.com/ethereum/kps/tree/main/libs/js/packages/core#readme",
  "bugs": "https://github.com/ethereum/kps/issues",
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./webrtc": { "types": "./dist/webrtc.d.ts", "default": "./dist/webrtc.js" }
  },
  "files": ["dist", "src"],
  "scripts": { "build": "rm -rf dist && tsc", "prepack": "npm run build" },
  "devDependencies": { "typescript": "^5.6.0" }
}
